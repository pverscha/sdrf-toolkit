[Term]
id: DOID:175
name: vascular cancer
def: "An organ system cancer located_in the vascular system that is characterized by the proliferation of angioblastic or other cells forming tumors within the blood vessels or lymph vessels." [url:http\://en.wikipedia.org/wiki/Angioma, url:https\://www.ncbi.nlm.nih.gov/pubmed/23327728]
is_a: DOID:4 ! disease

[Term]
id: DOID:0001816
name: angiosarcoma
def: "A vascular cancer that derives_from the cells that line the walls of blood vessels or lymphatic vessels." [url:http\://en.wikipedia.org/wiki/Hemangiosarcoma]
synonym: "hemangiosarcoma" EXACT []
xref: MESH:D006394
xref: NCI:C3088
xref: SNOMEDCT_US_2023_03_01:39000009
is_a: DOID:175 ! vascular cancer

[Term]
id: DOID:0014667
name: disease of metabolism
def: "A disease that involves errors in metabolic processes of building or degradation of molecules." [url:http\://www.ncbi.nlm.nih.gov/books/NBK22259/]
synonym: "metabolic disease" EXACT []
xref: ICD10CM:E88.9
xref: MESH:D008659
xref: NCI:C3235
